{
  "name": "monthloom",
  "version": "0.1.0",
  "description": "Dependency-free calendar grids, month navigation, and an optional browser widget.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "require": "./dist/dom.cjs"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css",
    "RELEASING.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test",
    "check": "npm run build && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "build:pages": "node scripts/build-pages.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goudam-jm/Monthloom.git"
  },
  "keywords": [
    "calendar",
    "date",
    "month",
    "datepicker"
  ],
  "license": "MIT",
  "devDependencies": {
    "linkedom": "0.18.13"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://goudam-jm.github.io/Monthloom/",
  "bugs": {
    "url": "https://github.com/goudam-jm/Monthloom/issues"
  }
}
