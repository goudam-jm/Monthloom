{
  "name": "monthloom",
  "version": "0.1.0",
  "description": "Build custom month calendars. Zero runtime dependencies. Any framework.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "require": "./dist/dom.cjs"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css",
    "RELEASING.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test",
    "check": "npm run build && npm run build:pages && npm test && npm run check:types",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "build:pages": "node scripts/build-pages.js",
    "check:types": "tsc -p test/types/tsconfig.json",
    "size": "npm run build && node scripts/measure-size.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goudam-jm/Monthloom.git"
  },
  "keywords": [
    "calendar",
    "month-grid",
    "headless",
    "date-utils",
    "vanilla-javascript",
    "typescript",
    "datepicker"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.28.2",
    "linkedom": "0.18.13",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://goudam-jm.github.io/Monthloom/",
  "bugs": {
    "url": "https://github.com/goudam-jm/Monthloom/issues"
  }
}
